 	Key   Node // Key of the pair.
 	Value Node // Value of the pair.
 }
+
+// Catch arm filter kinds.
+const (
+	CatchFilterNone    = ""        // Arm matches any error.
+	CatchFilterMessage = "message" // Arm matches errors whose message contains Filter.
+	CatchFilterTag     = "tag"     // Arm matches errors whose tag equals Filter.
+)
+
+// CatchClause represents a single catch arm of a try/catch expression.
+type CatchClause struct {
+	ErrorVar   string // Name the caught error is bound to ("" when unbound).
+	FilterKind string // One of CatchFilterNone, CatchFilterMessage, CatchFilterTag.
+	Filter     string // Substring or tag to match, depending on FilterKind.
+	Body       Node   // Body of the catch arm.
+}
+
+// TryCatchNode represents a try/catch expression with ordered catch arms.
+type TryCatchNode struct {
+	base
+	Try     Node
+	Catches []*CatchClause
+	Finally Node
+}
+
+// RetryNode represents a retry expression inside a catch block.
+type RetryNode struct {
+	base
+}
+
+// ScopedNode represents a scoped { ... } block with deferred cleanup.
+type ScopedNode struct {
+	base
+	Body Node
+}
