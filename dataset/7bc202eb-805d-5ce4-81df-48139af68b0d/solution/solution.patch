 }
+
+func (n *TryCatchNode) String() string {
+	s := fmt.Sprintf("try { %s }", n.Try.String())
+	for _, c := range n.Catches {
+		s += " catch"
+		if c.ErrorVar != "" {
+			s += " " + c.ErrorVar
+		}
+		switch c.FilterKind {
+		case CatchFilterMessage:
+			s += fmt.Sprintf(" is %q", c.Filter)
+		case CatchFilterTag:
+			s += " is #" + c.Filter
+		}
+		s += fmt.Sprintf(" { %s }", c.Body.String())
+	}
+	if n.Finally != nil {
+		s += fmt.Sprintf(" finally { %s }", n.Finally.String())
+	}
+	return s
+}
+
+func (n *RetryNode) String() string {
+	return "retry"
+}
+
+func (n *ScopedNode) String() string {
+	return fmt.Sprintf("scoped { %s }", n.Body.String())
+}
