+
+func (v *Checker) mergeNatures(t1, t2 Nature) Nature {
+	if t1.Nil && !t2.Nil {
+		return t2
+	}
+	if !t1.Nil && t2.Nil {
+		return t1
+	}
+	if t1.Nil && t2.Nil {
+		return v.config.NtCache.NatureOf(nil)
+	}
+	if t1.Type == nil || t2.Type == nil {
+		return Nature{}
+	}
+	if t1.AssignableTo(t2) {
+		return t1
+	}
+	return Nature{}
