new file mode 100644
index 0000000..fec2752
--- /dev/null
+++ b/builtin/errors.go
@@ -0,0 +1,161 @@
+package builtin
+
+import (
+	"fmt"
+	"reflect"
+)
+
+// noDeref keeps builtin arguments as-is: error values are *ExprError
+// pointers and must not be dereferenced into struct values.
+func noDeref(i int, arg reflect.Type) bool {
+	return false
+}
+
+// ExprError is the first-class error value exposed to expressions. It carries
+// a message, an optional tag, optional metadata and an optional cause chain.
+type ExprError struct {
+	Message  string
+	Tag      string
+	Metadata map[string]any
+	Cause    *ExprError
+}
+
+func (e *ExprError) Error() string {
+	return e.Message
+}
+
+// ToExprError converts any error into an *ExprError. An *ExprError is
+// returned as-is; any other error is wrapped into an untagged *ExprError
+// whose message is the error's message.
+func ToExprError(err error) *ExprError {
+	if e, ok := err.(*ExprError); ok {
+		return e
+	}
+	return &ExprError{Message: err.Error()}
+}
+
+// CloneChain returns a copy of the given error and its whole cause chain.
+func CloneChain(e *ExprError) *ExprError {
+	if e == nil {
+		return nil
+	}
+	c := *e
+	c.Cause = CloneChain(e.Cause)
+	return &c
+}
+
+// AppendCause returns a copy of err whose cause chain is extended with cause
+// appended after the current root cause.
+func AppendCause(err error, cause *ExprError) *ExprError {
+	head := CloneChain(ToExprError(err))
+	root := head
+	for root.Cause != nil {
+		root = root.Cause
+	}
+	root.Cause = cause
+	return head
+}
+
+// NewError implements the error() builtin: error(message[, tag[, metadata]]).
+func NewError(args ...any) (any, error) {
+	msg, ok := args[0].(string)
+	if !ok {
+		return nil, fmt.Errorf("error() message must be a string, got %T", args[0])
+	}
+	e := &ExprError{Message: msg}
+	if len(args) > 1 {
+		tag, ok := args[1].(string)
+		if !ok {
+			return nil, fmt.Errorf("error() tag must be a string, got %T", args[1])
+		}
+		e.Tag = tag
+	}
+	if len(args) > 2 {
+		meta, ok := args[2].(map[string]any)
+		if !ok {
+			return nil, fmt.Errorf("error() metadata must be a map, got %T", args[2])
+		}
+		e.Metadata = meta
+	}
+	return e, nil
+}
+
+// Errmsg implements the errmsg() builtin.
+func Errmsg(arg any) any {
+	switch e := arg.(type) {
+	case *ExprError:
+		return e.Message
+	case error:
+		return e.Error()
+	}
+	panic(fmt.Errorf("errmsg() expects an error value, got %T", arg))
+}
+
+// Errtag implements the errtag() builtin. A missing tag reads as "".
+func Errtag(arg any) any {
+	switch e := arg.(type) {
+	case *ExprError:
+		return e.Tag
+	case error:
+		return ""
+	}
+	panic(fmt.Errorf("errtag() expects an error value, got %T", arg))
+}
+
+// Errmeta implements the errmeta() builtin. Missing metadata reads as {}.
+func Errmeta(arg any) any {
+	switch e := arg.(type) {
+	case *ExprError:
+		if e.Metadata == nil {
+			return map[string]any{}
+		}
+		return e.Metadata
+	case error:
+		return map[string]any{}
+	}
+	panic(fmt.Errorf("errmeta() expects an error value, got %T", arg))
+}
+
+// Rethrow implements the rethrow() builtin: it throws a new error whose
+// message is the given context and whose cause is the given error.
+func Rethrow(args ...any) (any, error) {
+	err, ok := args[0].(error)
+	if !ok {
+		return nil, fmt.Errorf("rethrow() expects an error value as the first argument, got %T", args[0])
+	}
+	var ctx string
+	if s, ok := args[1].(string); ok {
+		ctx = s
+	} else {
+		ctx = fmt.Sprintf("%v", args[1])
+	}
+	return nil, &ExprError{Message: ctx, Cause: ToExprError(err)}
+}
+
+// Causes implements the causes() builtin: the array of error values from the
+// given error outward through each cause to the root.
+func Causes(arg any) any {
+	err, ok := arg.(error)
+	if !ok {
+		panic(fmt.Errorf("causes() expects an error value, got %T", arg))
+	}
+	out := []any{}
+	for e := ToExprError(err); e != nil; e = e.Cause {
+		out = append(out, e)
+	}
+	return out
+}
+
+// Rootcause implements the rootcause() builtin: the innermost error of the
+// cause chain.
+func Rootcause(arg any) any {
+	err, ok := arg.(error)
+	if !ok {
+		panic(fmt.Errorf("rootcause() expects an error value, got %T", arg))
+	}
+	e := ToExprError(err)
+	for e.Cause != nil {
+		e = e.Cause
+	}
+	return e
+}
